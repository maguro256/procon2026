# Python
__pycache__/
*.py[cod]

# DB本体。追跡しない。
#   - app.py が動いている間ハートビートが last_seen を書き続けるので、
#     常に「変更あり」になって差分が汚れる
#   - バイナリなので複数人で作業すると毎回コンフリクトする（実際に起きた）
# db.py が初回起動時に作り、サンプルデータも入れる。デモ用のタスクは
# `python demo_data.py` で投入する。
gemmba.db
gemmba.db.bak
gemmba.db.before-reset-*

# SQLiteの一時ファイル（app.py 稼働中に出る）
gemmba.db-journal
gemmba.db-wal
gemmba.db-shm

# ラズパイのブローカー探索キャッシュ（環境ごとに異なる）
raspi/.broker_cache.json

# タッチパネルのキャリブレーション結果（個体ごとに異なる）
raspi/.touch_calibration.json

# 文字起こし用の venv（Python 3.11 + faster-whisper）。数GBあるので追跡しない。
#   py -3.11 -m venv .venv-voice
#   .venv-voice/Scripts/python -m pip install -r voice/requirements.txt
.venv-voice/
